# Every node persists the first observed indexer reorg epoch in its chain data
# directory. A later epoch change halts that network generation until operators
# archive it and start a new generation from empty USDB chain data.
USDB_DEEP_REORG_GUARD_ENABLED=1
USDB_DEEP_REORG_GUARD_POLL_INTERVAL_SECS=5
USDB_DEEP_REORG_GUARD_REQUEST_TIMEOUT_SECS=5
USDB_DEEP_REORG_GUARD_MAX_CONSECUTIVE_ERRORS=3

# Digest-pinned GHCR candidate images. Tags, latest, local, and placeholders are rejected.
USDB_SERVICES_IMAGE=
USDB_CHAIN_IMAGE=

# Each node should use its local Bitcoin Core mainnet RPC. Use a dedicated RPC account.
BTC_RPC_URL=http://host.docker.internal:8332
BTC_AUTH_MODE=userpass
BTC_RPC_USER=
BTC_RPC_PASSWORD=

# Directory containing snapshot_963800.db, its manifest, and detached signature.
BH_SNAPSHOT_HOST_DIR=/home/usdb/.usdb/releases/balance-history/snapshot-963800

# The first node can start as full or bootnode. Mining additionally requires both values below.
USDB_NODE_ROLE=full
USDB_BOOTNODES=
USDB_NAT=
USDB_MINER_ADDRESS=
USDB_PASS_ID=
USDB_MINER_THREADS=1

# Public P2P, local-only operator APIs.
USDB_P2P_BIND_ADDRESS=0.0.0.0
USDB_P2P_BIND_PORT=31303
USDB_HTTP_BIND_ADDRESS=127.0.0.1
USDB_HTTP_BIND_PORT=8545
USDB_WS_BIND_ADDRESS=127.0.0.1
USDB_WS_BIND_PORT=8546
BH_BIND_ADDRESS=127.0.0.1
USDB_INDEXER_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1

# 32 GiB host profile. The cgroup limit is the balance-history memory ceiling.
BH_MEMORY_LIMIT=20g
BH_SYNC_UTXO_MAX_CACHE_BYTES=4294967296
BH_SYNC_BALANCE_MAX_CACHE_BYTES=10737418240
BH_SYNC_MAX_MEMORY_PERCENT=75
USDB_INDEXER_MEMORY_LIMIT=4g
USDB_CHAIN_MEMORY_LIMIT=5g
CONTROL_PLANE_MEMORY_LIMIT=1g

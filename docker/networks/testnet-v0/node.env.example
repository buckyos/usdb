# Digest-pinned GHCR candidate images. Tags, latest, local, and placeholders are rejected.
USDB_SERVICES_IMAGE=
USDB_CHAIN_IMAGE=
USDB_BITCOIN_IMAGE=

# Bitcoin Core runs as an independent Compose project and keeps its data across USDB resets.
BTC_NODE_DATA_HOST_DIR=/home/usdb/.usdb/bitcoin/mainnet
BTC_RPCAUTH_HOST_FILE=/home/usdb/.usdb/secure/bitcoin-mainnet-rpcauth
BTC_RPC_URL=http://btc-node:8332
BTC_AUTH_MODE=userpass
BTC_RPC_USER=
BTC_RPC_PASSWORD=
# Bitcoin inbound P2P is optional for USDB. Keep this loopback-only unless this
# node is intentionally contributing public inbound capacity to Bitcoin.
BTC_P2P_BIND_ADDRESS=127.0.0.1
BTC_P2P_BIND_PORT=8333
BTC_CONTAINER_UID=1000
BTC_CONTAINER_GID=1000
BTC_MEMORY_LIMIT=5g
BTC_DBCACHE_MB=3072
BTC_DISABLE_WALLET=1

# Snapshot is an optional node-local bootstrap accelerator. The first-node
# full-sync path keeps the staging directory empty and starts from BTC genesis.
SNAPSHOT_MODE=none
BH_SNAPSHOT_HOST_DIR=/home/usdb/.usdb/releases/balance-history
BH_SNAPSHOT_FILE=
BH_SNAPSHOT_MANIFEST=
BH_SNAPSHOT_TRUST_MODE=signed
BH_SNAPSHOT_TRUSTED_KEYS_FILE=/run/usdb/keys/usdb-mainnet-snapshot-v1.trusted-keys.json

# The first node can start as full or bootnode. Mining additionally requires both values below.
USDB_NODE_ROLE=full
USDB_BOOTNODES=
USDB_NAT=
USDB_MINER_ADDRESS=
USDB_PASS_ID=
USDB_MINER_THREADS=1

# Public P2P, local-only operator APIs.
USDB_P2P_BIND_ADDRESS=0.0.0.0
USDB_P2P_BIND_PORT=31303
USDB_HTTP_BIND_ADDRESS=127.0.0.1
USDB_HTTP_BIND_PORT=8545
USDB_WS_BIND_ADDRESS=127.0.0.1
USDB_WS_BIND_PORT=8546
BH_BIND_ADDRESS=127.0.0.1
USDB_INDEXER_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1

# 32 GiB co-located profile. Full sync uses Bitcoin Core's local block files;
# the limits retain headroom for Bitcoin Core and the operating system.
BH_MEMORY_LIMIT=12g
BH_SYNC_LOCAL_LOADER_THRESHOLD=500
BH_SYNC_UTXO_MAX_CACHE_BYTES=2147483648
BH_SYNC_BALANCE_MAX_CACHE_BYTES=6442450944
BH_SYNC_MAX_MEMORY_PERCENT=75
USDB_INDEXER_MEMORY_LIMIT=4g
USDB_CHAIN_MEMORY_LIMIT=5g
CONTROL_PLANE_MEMORY_LIMIT=1g

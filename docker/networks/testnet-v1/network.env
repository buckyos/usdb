USDB_NETWORK_BUNDLE_ID=usdb-testnet-v1
USDB_CHAIN_ID=202610030
USDB_NETWORK_ID=202610030
USDB_DOCKER_NETWORK=usdb-testnet-v1

BTC_NETWORK=bitcoin
BTC_MIN_READY_HEIGHT=963800
BTC_MAX_TIP_AGE_SECS=7200
BTC_MIN_CONNECTIONS=1
USDB_GENESIS_BLOCK_HEIGHT=963800
BTC_ACTIVATION_REGISTRY_ID=53b4bfed53b55a4accbd947d04d113a684f1af896d39d2d9bd984e07ad543f32

USDB_P2P_PORT=31303
USDB_DISCOVERY_PORT=31303
USDB_HTTP_PORT=8545
USDB_WS_PORT=8546

# Every node persists the first observed indexer reorg epoch in its chain data
# directory. A later epoch change halts that network generation until operators
# archive it and start a new generation from empty USDB chain data.
USDB_DEEP_REORG_GUARD_ENABLED=1
USDB_DEEP_REORG_GUARD_POLL_INTERVAL_SECS=5
USDB_DEEP_REORG_GUARD_REQUEST_TIMEOUT_SECS=5
USDB_DEEP_REORG_GUARD_MAX_CONSECUTIVE_ERRORS=3

BTC_ACTIVATION_REGISTRY_CATALOG_FILE=/network/btc-activation-registry-catalog.json
USDB_RULES_SCOPE=usdb-testnet-v1

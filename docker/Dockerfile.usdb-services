FROM rust:1.91.0-bookworm AS builder

WORKDIR /workspace/src/btc

COPY .cargo /workspace/.cargo

RUN cargo install cargo-auditable --version 0.7.5 --locked

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang \
        libclang-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY src/btc /workspace/src/btc

RUN cargo auditable build --locked --release -p balance-history -p usdb-indexer -p usdb-indexer-checkpoint-tool -p usdb-control-plane

FROM rust:1.89.0-bookworm AS ord-builder

ARG ORD_VERSION=0.23.3
ARG ORD_REVISION=ba60f87b530c01b15f6f8645e2ed4ef52f3f9f74

RUN cargo install cargo-auditable --version 0.7.5 --locked

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
COPY docker/locks/ord-0.23.3.Cargo.lock /tmp/ord-release.Cargo.lock
RUN git clone --branch "${ORD_VERSION}" --depth 1 https://github.com/ordinals/ord.git /tmp/ord-src \
    && cd /tmp/ord-src \
    && test "$(git rev-parse HEAD)" = "${ORD_REVISION}" \
    && cp /tmp/ord-release.Cargo.lock Cargo.lock \
    && cargo auditable build --locked --bin ord --release \
    && mkdir -p /opt/ord/bin \
    && install -m 0755 /tmp/ord-src/target/release/ord /opt/ord/bin/ord

FROM node:20-bookworm AS web-builder

WORKDIR /workspace/web

COPY web/usdb-console-app/package.json web/usdb-console-app/package-lock.json ./usdb-console-app/
COPY web/balance-history-browser/package.json web/balance-history-browser/package-lock.json ./balance-history-browser/
COPY web/usdb-indexer-browser/package.json web/usdb-indexer-browser/package-lock.json ./usdb-indexer-browser/
RUN cd usdb-console-app \
    && npm ci \
    && cd ../balance-history-browser \
    && npm ci \
    && cd ../usdb-indexer-browser \
    && npm ci

COPY web /workspace/web
RUN cd usdb-console-app \
    && npm run build \
    && cd ../balance-history-browser \
    && npm run build \
    && cd ../usdb-indexer-browser \
    && npm run build

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        openssl \
        python3 \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/src/btc/target/release/balance-history /usr/local/bin/balance-history
COPY --from=builder /workspace/src/btc/target/release/usdb-indexer /usr/local/bin/usdb-indexer
COPY --from=builder /workspace/src/btc/target/release/usdb-indexer-checkpoint-tool /usr/local/bin/usdb-indexer-checkpoint-tool
COPY --from=builder /workspace/src/btc/target/release/usdb-control-plane /usr/local/bin/usdb-control-plane
COPY --from=ord-builder /opt/ord/bin/ord /opt/ord/bin/ord
COPY docker/scripts /opt/usdb/docker/scripts
COPY web /opt/usdb/web
COPY --from=web-builder /workspace/web/usdb-console-app/dist /opt/usdb/web/usdb-console-app/dist
COPY --from=web-builder /workspace/web/balance-history-browser/dist /opt/usdb/web/balance-history-browser/dist
COPY --from=web-builder /workspace/web/usdb-indexer-browser/dist /opt/usdb/web/usdb-indexer-browser/dist

ENV PATH="/opt/usdb/docker/scripts:/opt/usdb/docker/scripts/tools:/opt/usdb/docker/scripts/entrypoints:/opt/usdb/docker/scripts/helpers:${PATH}"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash"]
